{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mig-000001-1/target-account.schema.json",
  "title": "Target System account document (TARGET, project1)",
  "description": "Every emitted TARGET document is validated against this schema before it leaves the engine, so a mapping bug surfaces as a reject rather than as bad data in Target System.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "customerId",
    "productCode",
    "currency",
    "openedOn",
    "status",
    "balance",
    "migration"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^[A-Z0-9]+$"
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "productCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "openedOn": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "CLOSED", "DORMANT"]
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "description": "Carried as a string so no precision is lost through JSON float handling.",
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segment": { "type": "string" },
        "branch": { "type": "string" },
        "riskRating": { "type": "integer", "minimum": 1, "maximum": 10 },
        "branchName": {
          "description": "Resolved by the Data Enrichment pipeline from reference data.",
          "type": "string"
        }
      }
    },
    "migration": {
      "description": "Provenance that lets reconciliation tie this document back to its SRC record and run.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "sourceKey", "dedupKey"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "sourceKey": { "type": "string", "minLength": 1 },
        "dedupKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
