<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ro.mig</groupId>
    <artifactId>mig-000001-1</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>recon-service</artifactId>
  <name>recon-service</name>

  <dependencies>
    <dependency>
      <groupId>ro.mig</groupId>
      <artifactId>common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Consumes the confirmation stream the target-system-mock publishes on every accepted
      write (docs/PLAN-CHANGES-22082026.md), so recon can prove each TARGET row was actually
      persisted rather than only posted. A fresh consumer group per run (recon-<runId>)
      reads the topic bounded by its end offsets, then a set-difference join against
      account_target.account_key names any unconfirmed rows. Absent bootstrap → the read
      is skipped and the report records enabled=false, which keeps a no-Kafka run green.
    -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Packages one self-contained jar at target/recon-service.jar, runnable with `java -jar`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>recon-service</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>ro.mig.recon.ReconService</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
