# Copy to .env — `make bootstrap` does this for you.
# Every endpoint here is what makes the local/GCP switch a config change, not a code change.

# ---------------------------------------------------------------- target profile
# local = emulators (default) | real = real GCP services
TARGET_PROFILE=local

# ---------------------------------------------------------------- object storage
# Local: fake-gcs-server. Real GCP: unset STORAGE_EMULATOR_HOST entirely.
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_LANDING_BUCKET=mig-landing
GCS_JSON_BUCKET=mig-json-out
GCS_RECON_BUCKET=mig-recon

# ---------------------------------------------------------------- bigquery
# BQ_TARGET: emulator | real   (real = free BigQuery sandbox, no billing needed)
BQ_TARGET=emulator
BIGQUERY_EMULATOR_HOST=http://localhost:9050
GCP_PROJECT=mig-local
BQ_DATASET_EXTRACTION=bq_extraction
BQ_DATASET_TRANSFORMATION=bq_transformation
BQ_DATASET_RECON=bq_recon

# ---------------------------------------------------------------- kafka
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC=target-system-target
KAFKA_BATCH_SIZE=200
# local: PLAINTEXT | real GCP Managed Kafka: SASL_SSL + OAUTHBEARER
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ---------------------------------------------------------------- target system
TARGET_SYSTEM_URL=http://localhost:8080
TARGET_SYSTEM_FAILURE_RATE=0.15
TARGET_SYSTEM_MAX_RETRIES=5
# Confirmation stream (docs/PLAN-CHANGES-22082026.md): the mock publishes one event per
# accepted write here; recon consumes it and joins to account_target by account_key.
# Empty bootstrap = no confirmation stream (the mock skips the producer, recon skips the
# read), which is how a no-Kafka run stays green.
TARGET_SYSTEM_CONFIRMATION_BOOTSTRAP=localhost:19092
TARGET_SYSTEM_CONFIRMATION_TOPIC=target-system-confirmations
# Rejection stream (docs/PLAN-CHANGES-02092026-kafka-loader.md): once the Load edge is
# Kafka there is no HTTP status to classify, so a refused document is published here with
# the mock's own reason string and becomes the loader's .ERR row. Without it a bad
# document is indistinguishable from a slow one and lands in `unsettled`.
TARGET_SYSTEM_REJECTION_TOPIC=target-system-rejections
# Which Load edge the loader uses: kafka (produce + settle) or http (POST /v1/accounts).
# Both are runnable against the same acceptance suite for one release.
MIG_LOADER_SINK=kafka
# How long the loader waits on the return topics before calling the rest unsettled.
LOADER_SETTLE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- pgp
PGP_RECIPIENT=mig-prototype@example.invalid
PGP_HOME=local/keys

# ---------------------------------------------------------------- active contract
# The ONLY line that changes between project1 and project2 — must-prove #3.
MAPPING=contracts/mappings/mapping-project1.yaml

# ---------------------------------------------------------------- harness
HARNESS_ACCOUNTS=2000
HARNESS_TX_PER_ACCOUNT=5
