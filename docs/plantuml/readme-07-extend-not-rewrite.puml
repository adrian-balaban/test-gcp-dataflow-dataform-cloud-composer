}

rectangle "Engine — zero code diff" as engine #f5fbf5 {
    rectangle "Beam pipelines · Dataform · recon" as PIPE #dff0d8
}

Y1 --> PIPE
Y2 --> PIPE
T1 --> PIPE
S1 --> PIPE
@enduml
