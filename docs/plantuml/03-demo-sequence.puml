@startuml 03-demo-sequence
' PlantUML equivalent of docs/inputs/diagrams/03-demo-sequence.mmd

skinparam shadowing false
skinparam sequence {
    ArrowColor #555555
    LifeLineBorderColor #999999
    ParticipantBorderColor #666666
    ParticipantBackgroundColor #eef4fa
    ParticipantFontColor #1b1b1b
}

participant "Synthetic Harness"      as Gen
participant "TDS (SRC/TARGET)"       as TDS
participant "Transformation Engine"  as Eng
participant "Reject File"            as RJ
participant "Kafka Stub"             as K
participant "Reconciliation"         as Rec

Gen -> TDS : SRC records (.DAT + JSON + malformed + dupes)
TDS -> Eng : parsed SRC
Eng -> RJ  : unparseable / unmappable records + reason codes
Eng -> Eng : filter corporate/private-bank
Eng -> Eng : map + transform SRC -> TARGET
Eng -> Eng : checkpoint per batch
Eng -> K   : emit TARGET in 200-batches
Eng -> Rec : SRC counts + keys (in), excluded, rejected
K   -> Rec : TARGET counts + keys (out)
Rec --> Gen : balancing report — SRC = written + excluded + rejected + dupes
@enduml
